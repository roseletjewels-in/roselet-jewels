# =====================================================================
# ROSELET JEWELS - STREAMLIT SECRETS CONFIGURATION TEMPLATE
# Copy this file to `.streamlit/secrets.toml` to connect cloud services.
# If left empty, the application automatically runs in local SQLite mode!
# =====================================================================

# Admin ERP Panel Password
ADMIN_PASSWORD = "roseletadmin2026"

# Business WhatsApp Phone Number (with Country Code, no + or spaces)
# Example: 919847012345 for +91 98470 12345
BUSINESS_WHATSAPP = "919847012345"

# Supabase Cloud PostgreSQL & Storage Configuration (Optional)
# Get these from https://supabase.com -> Project Settings -> API
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-or-service-role-key"

# Chatwoot Live Chat Widget Token (Optional - for Omnichannel CRM)
# Get from Chatwoot Cloud -> Settings -> Inboxes -> Website Channel
CHATWOOT_BASE_URL = "https://app.chatwoot.com"
CHATWOOT_WEBSITE_TOKEN = "your-chatwoot-website-token"
